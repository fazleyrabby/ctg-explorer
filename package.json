{
  "name": "chattogram-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based 3D open-world exploration game built on real Chattogram geography.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "world:dem": "tsx scripts/fetch-dem.ts",
    "world:roads": "tsx scripts/fetch-roads.ts",
    "world:buildings": "tsx scripts/fetch-buildings.ts",
    "world:compact": "node --import tsx scripts/curate-city.ts",
    "test:world": "node --import tsx scripts/test-district.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.180.0",
    "fast-xml-parser": "^5.11.1",
    "geotiff": "^3.0.5",
    "osm-pbf-parser": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
